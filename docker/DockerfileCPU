# CPU-only image for the reg23 napari GUI app (python -m reg23_app).
#
# Build (from the repository root; the build context must be the repo root):
#   docker build -f docker/DockerfileCPU -t reg23-app:cpu .
#
# Run, option A: in your browser (works on Linux / macOS / Windows, no X server needed).
# The container starts a virtual display and serves it over noVNC:
#   docker run --rm -it --init -p 127.0.0.1:6080:6080 \
#       -v "$PWD/data:/app/data" -v "$PWD/cache:/app/cache" \
#       reg23-app:cpu
#   then open http://localhost:6080/vnc.html?autoconnect=true&resize=scale
#
# Run, option B: on the window system of a Linux host (X11 / XWayland):
#   xhost +local:docker
#   docker run --rm -it --init -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix \
#       -v "$PWD/data:/app/data" -v "$PWD/cache:/app/cache" \
#       reg23-app:cpu
#
# Anything after the image name is passed to the app, e.g.
#   ... reg23-app:cpu --ct-path /app/data/my_ct.nrrd
# or run something else entirely (e.g. a shell):  ... reg23-app:cpu bash
#
# Notes:
# - linux/amd64 only (the upstream `triangle` dependency has no linux/arm64 wheel). The stages are pinned to
#   amd64, so on Apple Silicon Docker builds and runs it under emulation automatically (slower).
# - Add `--user "$(id -u):$(id -g)"` to stop files written into bind mounts being owned by root.

# ---------------------------------------------------------------- builder
FROM --platform=linux/amd64 python:3.12-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON_PREFERENCE=only-system \
    PYTHONDONTWRITEBYTECODE=1

# Compiler toolchain for the reg23_core C++ extension (python.h ships with the official python image).
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ninja-build \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY pyproject.toml uv.lock .python-version logging.conf ./
COPY packages packages

# NOTE: `--package reg23-app` is essential. reg23-app (napari, PyQt6, ...) is a workspace member that the root project
# does not depend on, so a plain `uv sync --extra cpu` never installs the GUI or its dependencies.

# 1) All third-party dependencies, including the CPU build of torch/torchvision (from the lockfile).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package reg23-app --extra cpu --no-install-workspace

# 2) The workspace packages (editable). reg23-core is a C++ extension compiled against torch, so build it without
#    build isolation: it then uses the CPU torch installed above rather than pulling a ~GB CUDA torch from PyPI just
#    to compile against. Lower MAX_JOBS if the build runs out of memory.
ARG MAX_JOBS=2
ENV MAX_JOBS=${MAX_JOBS}
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package reg23-app --extra cpu --no-build-isolation-package reg23-core

# Fail the build now if the compiled extension or torch is broken.
RUN /app/.venv/bin/python -c "import torch, reg23_core; print('torch', torch.__version__, '| cuda available:', torch.cuda.is_available())"

# ---------------------------------------------------------------- runtime
FROM --platform=linux/amd64 python:3.12-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Qt6 (xcb) + software OpenGL (Mesa llvmpipe) + VTK runtime libs, fonts, and a virtual display served over noVNC.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libgl1 libglx-mesa0 libgl1-mesa-dri libegl1 \
        libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 fonts-dejavu-core \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxcursor1 libxinerama1 libsm6 libice6 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render0 \
        libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 \
        libxcb-xinput0 libxcb-xkb1 \
        xvfb x11vnc novnc websockify \
 && ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The venv and the (editable, in-place compiled) workspace packages must come from the builder, at the same path.
COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    QT_API=PyQt6 \
    QT_QPA_PLATFORM=xcb \
    QT_X11_NO_MITSHM=1 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    HOME=/app/home \
    XDG_CONFIG_HOME=/app/home/.config \
    XDG_CACHE_HOME=/app/home/.cache \
    MPLCONFIGDIR=/app/home/.config/matplotlib

# Directories the app writes to (relative to the working directory). World-writable so that
# `docker run --user <uid>:<gid>` works too. Bind-mount data/ and cache/ to keep their contents.
RUN mkdir -p /app/data /app/cache /app/Logs /app/home \
 && chmod -R a+rwX /app/data /app/cache /app/Logs /app/home

# Build-time checks: (1) every shared library the Qt xcb platform plugin needs is installed;
# (2) the app and all of its GUI dependencies import.
RUN missing="$(for p in $(find /app/.venv -path '*PyQt6*' -name libqxcb.so); do ldd "$p" | grep 'not found' || true; done)"; \
    if [ -n "$missing" ]; then echo "Missing libraries for the Qt xcb plugin:"; echo "$missing"; exit 1; fi \
 && QT_QPA_PLATFORM=offscreen python -c "import napari, reg23_core, reg23_app.__main__; print('imports OK')"

RUN cat > /entrypoint.sh <<'EOF'
#!/bin/bash
set -e

# No display given: start a virtual one and serve it to the browser through noVNC.
if [ -z "${DISPLAY:-}" ]; then
    export DISPLAY=:99
    rm -f /tmp/.X99-lock
    Xvfb "$DISPLAY" -screen 0 "${SCREEN_RESOLUTION:-3840x2160x24}" -nolisten tcp +extension GLX +render -noreset \
        >/tmp/xvfb.log 2>&1 &
    for _ in $(seq 1 100); do
        [ -e /tmp/.X11-unix/X99 ] && break
        sleep 0.1
    done
    x11vnc -display "$DISPLAY" -forever -shared -nopw -localhost -rfbport 5900 -noxdamage -quiet \
        >/tmp/x11vnc.log 2>&1 &
    websockify --web=/usr/share/novnc 6080 localhost:5900 >/tmp/websockify.log 2>&1 &
    echo "Virtual display started. Open http://localhost:6080/vnc.html?autoconnect=true&resize=scale"
fi

# `docker run IMAGE bash` (or any command that isn't an option) runs that command instead of the app.
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
    exec "$@"
fi
exec python -m reg23_app "$@"
EOF
RUN chmod +x /entrypoint.sh

EXPOSE 6080
ENTRYPOINT ["/entrypoint.sh"]
