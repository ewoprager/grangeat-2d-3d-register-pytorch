# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Build stage
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy the complete workspace metadata and source.
COPY pyproject.toml uv.lock .python-version ./
COPY packages ./packages

# First install third-party dependencies only, so this layer can be cached.
# Crucially, select reg23-app rather than the workspace root.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
        --frozen \
        --package reg23-app \
        --extra cpu \
        --no-install-workspace

# Now install the selected workspace member and its workspace dependencies.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
        --frozen \
        --package reg23-app \
        --extra cpu

# ---------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Qt / napari runtime libraries.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libegl1 \
        libopengl0 \
        libglib2.0-0 \
        libfontconfig1 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xinput0 \
        libxcb-xfixes0 \
        libxrender1 \
        libxext6 \
        libxinerama1 \
        libsm6 \
        libice6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# uv installs workspace packages in editable mode, so the source tree has
# to exist in the runtime image as well.
COPY --from=builder /app/.venv ./.venv
COPY --from=builder /app/pyproject.toml ./pyproject.toml
COPY --from=builder /app/.python-version ./.python-version
COPY --from=builder /app/packages ./packages

ENV PATH="/app/.venv/bin:$PATH"

# The application itself selects PyQt6, but setting this here also makes
# the choice explicit before napari/Qt is imported.
ENV QT_API=PyQt6

# Avoid Qt's MIT-SHM requirement when talking to the host X server.
ENV QT_X11_NO_MITSHM=1

ENTRYPOINT ["python", "-m", "reg23_app"]