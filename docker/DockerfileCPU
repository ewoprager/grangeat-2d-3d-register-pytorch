# ---- builder ----
FROM python:3.12-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

# --- system deps for napari / Qt ---
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    gcc \
    make \
    ninja-build \
    libgl1 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxrender1 \
    libxext6 \
    libxinerama1 \
    libsm6 \
    libice6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock .python-version logging.conf ./

COPY packages packages

RUN uv sync --extra cpu --no-install-workspace

RUN uv sync --extra cpu


# ---- runtime ----
FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libegl1 \
    libglib2.0-0 \
    libfontconfig1 \
    libdbus-1-3 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxrender1 \
    libxext6 \
    libxinerama1 \
    libsm6 \
    libice6 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/.venv .venv
COPY pyproject.toml logging.conf ./
COPY packages packages

ENV PATH="/app/.venv/bin:$PATH"

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]